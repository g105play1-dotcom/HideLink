{
  "name": "anonlink",
  "version": "0.1.0",
  "private": true,
  "description": "AnonLink — anonymous real-time chat with random matching and direct contact by User ID",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "diagnose": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @anonlink/api dev",
    "dev:web": "pnpm --filter @anonlink/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @anonlink/e2e test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @anonlink/api db:generate",
    "db:migrate": "pnpm --filter @anonlink/api db:migrate",
    "db:deploy": "pnpm --filter @anonlink/api db:deploy",
    "db:studio": "pnpm --filter @anonlink/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
