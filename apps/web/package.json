{
  "name": "@anonlink/web",
  "version": "0.1.0",
  "private": true,
  "description": "AnonLink web client: anonymous identity, random matching and direct chat.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
