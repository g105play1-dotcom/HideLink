// =============================================================================
// AnonLink — PostgreSQL schema (Prisma ORM 7)
// =============================================================================
// Design rules that this schema deliberately encodes:
//
//  1. NO personal data. There is no email, phone, name or password column
//     anywhere, because AnonLink never asks for them.
//  2. Message bodies exist in exactly two places, and both are deliberate:
//       - `Report.messageSnapshot`, so a human can act on a complaint;
//       - `ArchivedMessage`, only when the owner has switched archiving on (see
//         `ArchivePolicy`). It is off by default, owner-only, and the owner chooses
//         who, what and for how long. See docs/DECISIONS.md D21 and docs/SECURITY.md.
//     Outside those two, chat text lives only in the API process's memory while a
//     chat is active, and both stored forms carry a retention deadline
//     (`expiresAt`) that the maintenance job enforces.
//  3. Identifiers that could be used to correlate a person (`ipHash`,
//     `userAgentHash`) are stored only as salted SHA-256 hashes, and are only
//     written for abuse investigation.
//  4. Public identifiers (`publicId`) are random and unrelated to primary keys,
//     so a leaked public ID never discloses row counts or internal ordering.
//  5. Every table that grows without bound carries an explicit retention column
//     so the maintenance job can trim it.
//
// See docs/SECURITY.md and docs/DECISIONS.md for the reasoning behind each rule.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Controls whether other identities may start a *direct* chat with this one.
enum IncomingRequestPolicy {
  everyone
  nobody
}

/// Self-declared gender.
///
/// Unverified by construction — there is no sign-up to verify it against — so it is
/// used *only* to evaluate search filters, and is never shown to a peer. Absent means
/// "not stated", which never satisfies a gender filter.
enum Gender {
  female
  male
  other
}

enum ChatKind {
  random
  direct
}

enum ChatStatus {
  active
  ended
}

enum ReportReason {
  spam
  abuse
  sexual
  violence
  other
}

enum ReportStatus {
  open
  reviewed
  actioned
  dismissed
}

/// The subsection a user picked in the "contact the owner" form.
enum OwnerMessageTopic {
  /// A complaint about another user or about content.
  abuse
  /// An idea for the product.
  suggestion
  /// A defect report.
  bug
  /// An advertising enquiry.
  advertising
  /// A partnership / cooperation enquiry.
  partnership
  /// Anything that does not fit the boxes above.
  other
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

/// An anonymous identity. Created automatically on first use — no sign-up.
///
/// `id` is an internal, never-disclosed UUID. `publicId` is the "User ID" the
/// owner can see and share; it is random and not derivable from `id`.
model Identity {
  id        String   @id @default(uuid(7)) @db.Uuid
  publicId  String   @unique @db.VarChar(14)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  /// Updated on every authenticated request; drives presence and staleness checks.
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)

  /// Set when the identity is suspended for abuse. Nullable = not banned.
  bannedAt     DateTime? @db.Timestamptz(3)
  bannedReason String?   @db.VarChar(200)

  incomingRequests IncomingRequestPolicy @default(everyone)

  /// Legacy per-user switch, stored but no longer read.
  ///
  /// Until 2026-10-20 the user decided whether the block action existed. The owner
  /// corrected that: it is a platform policy, set in `/admin` (`PlatformPolicy`), so this
  /// column is kept only because migrations are additive — dropping it is not worth the
  /// risk and the data has no meaning. See docs/DECISIONS.md D31.
  blockingEnabled Boolean @default(true)

  // ---------------------------------------------------------------------------
  // Voluntary, self-declared profile and search filters.
  //
  // Every column below is optional and none of it is verified: AnonLink has no
  // registration, so there is nothing to verify against. The whole group exists so a
  // user can say "поиск: жен., 25-35, Москва" and be matched accordingly — it is a
  // preference hint for the matchmaker, never a published fact about a person.
  //
  // The languages are stored as free strings rather than a Postgres enum because the
  // vocabulary is expected to grow; the *values* are validated against the shared
  // `LANGUAGES` list on every write, so the database cannot hold a language the code
  // does not understand.
  // ---------------------------------------------------------------------------

  /// Self-declared gender (`Gender` enum). Null = not stated.
  declaredGender   Gender?
  /// Year of birth, not age: an age would silently go stale.
  declaredBirthYear Int?
  declaredCity     String? @db.VarChar(64)
  declaredRegion   String? @db.VarChar(64)
  declaredLanguages String[] @default([])

  /// Genders the owner wants to be matched with. Empty = no constraint.
  prefGenders  String[] @default([])
  /// Inclusive age bounds applied to the *candidate's* declared year of birth.
  prefAgeMin   Int?
  prefAgeMax   Int?
  /// Place names the candidate's declared city must be one of. Empty = anywhere.
  ///
  /// The filter names places; it no longer means "the same place as mine". The two
  /// lists form one union (docs/DECISIONS.md D27).
  prefCities   String[] @default([])
  /// Place names the candidate's declared region must be one of. Empty = anywhere.
  prefRegions  String[] @default([])
  /// Languages the owner wants the candidate to share at least one of. Empty = no constraint.
  prefLanguages String[] @default([])
  /// Whether the server may drop filters, visibly, after a long wait. Off by default.
  prefRelax    Boolean  @default(false)

  sessions       Session[]
  chatsAsA       ChatSession[] @relation("ChatParticipantA")
  chatsAsB       ChatSession[] @relation("ChatParticipantB")
  reportsMade    Report[]      @relation("ReportReporter")
  reportsAgainst Report[]      @relation("ReportTarget")
  blocksCreated  Block[]       @relation("BlockCreator")
  blocksReceived Block[]       @relation("BlockTarget")
  securityEvents SecurityEvent[]
  archiveSubjects ArchiveSubject[]
  ownerMessages OwnerMessage[]

  @@index([lastSeenAt])
  @@index([bannedAt])
}

// -----------------------------------------------------------------------------
// Sessions
// -----------------------------------------------------------------------------

/// A bearer session belonging to an anonymous identity.
///
/// Only `tokenHash` (SHA-256 of the random token) is persisted: a database leak
/// therefore does not hand out usable sessions. The raw token exists solely in
/// the browser's HttpOnly cookie.
model Session {
  id         String @id @default(uuid(7)) @db.Uuid
  identityId String @db.Uuid

  /// SHA-256 hex digest of the session token. 64 hex characters.
  tokenHash String @unique @db.Char(64)

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  /// Salted SHA-256 of the originating client IP. Optional, abuse-investigation only.
  ipHash String? @db.Char(64)
  /// Salted SHA-256 of the User-Agent. Optional, abuse-investigation only.
  userAgentHash String? @db.Char(64)

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Chats
// -----------------------------------------------------------------------------

/// Lifecycle record of a chat between two identities.
///
/// This table intentionally contains NO message bodies and NO message history:
/// AnonLink does not keep transcripts. Only metadata needed to run the service,
/// detect abuse patterns and enforce blocks is stored.
model ChatSession {
  id        String     @id @default(uuid(7)) @db.Uuid
  kind      ChatKind
  status    ChatStatus @default(active)

  startedAt DateTime  @default(now()) @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)
  /// One of `ChatEndReason` from @anonlink/shared.
  endReason String?   @db.VarChar(32)

  participantAId String   @db.Uuid
  participantBId String   @db.Uuid
  /// The identity that caused the chat to start. Always one of the participants.
  initiatorId    String   @db.Uuid

  participantA Identity @relation("ChatParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB Identity @relation("ChatParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)

  /// Coarse counter used for flood detection. Not a transcript.
  messageCount Int @default(0)

  reports Report[]
  /// Present only when the owner's archive policy selected this chat. See docs/SECURITY.md.
  archive ChatArchive?

  @@index([participantAId, status])
  @@index([participantBId, status])
  @@index([status, startedAt])
  @@index([initiatorId])
}

// -----------------------------------------------------------------------------
// Moderation
// -----------------------------------------------------------------------------

/// A user-submitted abuse report.
///
/// `messageSnapshot` is the *only* place in the database where message text can
/// exist. It is always taken from the server's own in-memory copy of the message
/// (never from client input) and it is deleted once `expiresAt` passes.
model Report {
  id     String  @id @default(uuid(7)) @db.Uuid
  chatId String? @db.Uuid

  reporterId String @db.Uuid
  targetId   String @db.Uuid

  reason  ReportReason
  details String?      @db.VarChar(1000)

  /// Server-side id of the reported message, when the report is message-specific.
  messageId String? @db.VarChar(64)
  /// Server-side snapshot of the reported message text. Retention-bound.
  messageSnapshot String? @db.VarChar(4000)

  status    ReportStatus @default(open)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  /// Retention deadline. The maintenance job hard-deletes expired reports.
  expiresAt DateTime     @db.Timestamptz(3)

  chat     ChatSession? @relation(fields: [chatId], references: [id], onDelete: SetNull)
  reporter Identity     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  target   Identity     @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([expiresAt])
  @@index([targetId, createdAt])
  @@index([reporterId, createdAt])
}

/// A one-directional block: `blocker` never wants to be matched with `blocked`.
///
/// Blocks are checked in both directions before a chat is created, so blocking is
/// symmetric in effect even though each direction is stored separately.
model Block {
  id        String   @id @default(uuid(7)) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  blocker Identity @relation("BlockCreator", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Identity @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Low-frequency, high-signal technical events used to investigate abuse.
///
/// Deliberately restricted to coarse event types. Message content, message text
/// and IP addresses must never be written here. High-frequency events such as
/// rate-limit trips are aggregated in memory instead, so this table cannot be
/// used as a write amplifier against the database.
model SecurityEvent {
  id String @id @default(uuid(7)) @db.Uuid

  /// Short machine-readable event name, e.g. `contact_blocked`.
  type String @db.VarChar(48)

  identityId String?  @db.Uuid
  /// Coarse target reference (never a raw IP address).
  targetId   String?  @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  /// Retention deadline enforced by the maintenance job.
  expiresAt DateTime @db.Timestamptz(3)

  identity Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([identityId, createdAt])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Contact the owner
// -----------------------------------------------------------------------------

/// A message a user deliberately addressed to the operator.
///
/// This is the second place where user-written text is stored on purpose, next to
/// `Report.messageSnapshot`, and it is deliberate for the same reason: the whole point of
/// the form is that a human reads it. Three things keep that honest —
///   * the user is told before sending (the form says the message is stored and will be
///     deleted after a retention period), unlike the silent archive of D21;
///   * the row is retention-bound (`expiresAt`, enforced by the maintenance job);
///   * the owner can delete any message, or all of them, at once.
/// See docs/DECISIONS.md D26 and docs/SECURITY.md.
model OwnerMessage {
  id String @id @default(uuid(7)) @db.Uuid

  /// The sender. `publicId` is read through the relation rather than duplicated here.
  identityId String? @db.Uuid

  topic OwnerMessageTopic
  text  String            @db.VarChar(2000)
  /// How the owner can answer, in the sender's own words. Optional and unverified:
  /// nothing checks that this is an e-mail or a phone number, and nothing sends to it.
  contact String? @db.VarChar(200)

  createdAt DateTime @db.Timestamptz(3) @default(now())
  /// Retention deadline. The maintenance job hard-deletes expired rows.
  expiresAt DateTime @db.Timestamptz(3)

  identity Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([expiresAt])
  @@index([topic, createdAt])
}

// -----------------------------------------------------------------------------
// Chat archives (owner-only, off by default)
// -----------------------------------------------------------------------------

/// Who an archive covers. `criteria` matches the declared attributes below;
/// `selected` matches the User IDs listed in `ArchiveSubject`.
enum ArchiveAudience {
  everyone
  criteria
  selected
}

/// The owner's archive policy. Exactly one row, with the fixed id `default`.
///
/// Off by default: an installation whose owner never touches this table stores no
/// transcripts at all. Every field is meant to be set by hand from the admin surface —
/// there is no automatic selection. See docs/PRODUCT_SPEC.md §20 and D21.
model ArchivePolicy {
  id       String          @id @default("default") @db.VarChar(16)
  enabled  Boolean         @default(false)
  audience ArchiveAudience @default(everyone)

  /// Criteria in force when `audience = criteria`. An empty list means "no constraint";
  /// every non-empty constraint must hold, exactly like a search filter. The negative
  /// case is deliberate: a person who never declared an attribute is *not* in scope.
  genders   String[] @default([])
  ageMin    Int?
  ageMax    Int?
  cities    String[] @default([])
  regions   String[] @default([])
  languages String[] @default([])

  /// Whether message text is kept.
  storeText Boolean @default(true)
  /// Attachment kinds to keep. Inert until AnonLink can send attachments at all.
  storeMedia String[] @default([])
  /// Days an archive is kept; `0` means "until the owner deletes it".
  retentionDays Int @default(90)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  subjects ArchiveSubject[]
}

/// A User ID the owner selected one by one, used when `audience = selected`.
model ArchiveSubject {
  id         String   @id @default(uuid(7)) @db.Uuid
  policyId   String   @default("default") @db.VarChar(16)
  identityId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  policy   ArchivePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  identity Identity      @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([policyId, identityId])
  @@index([identityId])
}

/// The stored transcript of one chat.
///
/// Created lazily with the first stored message, so a chat that stored nothing leaves no
/// row. `expiresAt` is null when the policy says "keep until deleted"; otherwise the
/// maintenance sweep removes the archive and, by cascade, every message in it.
model ChatArchive {
  id     String @id @default(uuid(7)) @db.Uuid
  chatId String @unique @db.Uuid

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  /// Retention deadline enforced by the maintenance job.
  expiresAt DateTime? @db.Timestamptz(3)

  messageCount Int @default(0)

  chat     ChatSession       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messages ArchivedMessage[]

  @@index([expiresAt])
  @@index([createdAt])
}

/// One stored message. Read only through the owner's admin surface.
///
/// `senderId` deliberately has no foreign key: an archive is a record of what happened,
/// and it must not be rewritten or removed by anything that happens to an identity row.
model ArchivedMessage {
  id        String @id @default(uuid(7)) @db.Uuid
  archiveId String @db.Uuid

  /// Who wrote it, so the transcript can say who said what.
  senderId String @db.Uuid

  /// Message text, present only when the policy stores text.
  text String? @db.VarChar(4000)

  /// Attachment slot. Both stay null until the product can send attachments.
  mediaKind String? @db.VarChar(24)
  mediaRef  String? @db.VarChar(512)

  sentAt DateTime @db.Timestamptz(3)
  /// Position within the chat, assigned by the server as messages are stored.
  seq    Int

  archive ChatArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@index([archiveId, seq])
}

// -----------------------------------------------------------------------------
// Platform policy (owner-controlled)
// -----------------------------------------------------------------------------

/// Switches that belong to the installation, not to a person.
///
/// Exactly one row, with the fixed id `default`. A missing row means the shipped
/// defaults, so an installation that never opened `/admin` needs no seed data.
///
/// `blockingEnabled` is the first entry: the owner decided (2026-10-20, D31) that the
/// availability of blocking is a moderation decision. It is **off** by default, which is
/// what the owner asked for — an action nobody can use until the owner enables it.
model PlatformPolicy {
  id String @id @default("default") @db.VarChar(16)

  /// Whether the "block a peer" action exists for anybody at all.
  ///
  /// Off hides the action in the interface and makes the API refuse new blocks. It never
  /// removes an existing block: silently un-blocking somebody would be a safety
  /// regression, and the block list stays readable so it can be undone by hand.
  blockingEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
