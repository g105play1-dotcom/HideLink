# =============================================================================
# AnonLink — environment configuration
# =============================================================================
# Copy this file to `.env` in the repository root and adjust the values.
#
#   PowerShell:  Copy-Item .env.example .env
#
# `.env` is git-ignored. NEVER commit real secrets to the repository.
# Both the API (apps/api) and the web app (apps/web) read this single file.
#
# Every variable is validated at boot (apps/api/src/config/env.ts). A bad value
# stops the API with a readable list of problems instead of failing later, and
# `pnpm diagnose` prints a full report.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local PostgreSQL installed by `pnpm setup` listens on port 5432.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://anonlink:anonlink@localhost:5432/anonlink?schema=public"

# Only needed by `prisma migrate dev` when it has to create a shadow database.
# Leave commented out to let Prisma create a temporary one automatically.
# SHADOW_DATABASE_URL=""

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
NODE_ENV="development"
API_PORT=3001
# Loopback only, so the API is not exposed to the local network and Windows does
# not need a firewall exception. Set to "0.0.0.0" only if you deliberately want
# other devices (or a container) to reach the API.
API_HOST="127.0.0.1"

# Comma-separated list of browser origins allowed to call the API and to open
# a WebSocket connection. Must match exactly (scheme + host + port).
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Set to "true" behind a reverse proxy (Caddy, nginx) so client IPs are read
# from X-Forwarded-For. Leave "false" when the API is reached directly: trusting
# the header without a proxy lets a client forge its own address.
TRUST_PROXY="false"

# -----------------------------------------------------------------------------
# Anonymous sessions
# -----------------------------------------------------------------------------
# Lifetime of an anonymous identity session, in days.
SESSION_TTL_DAYS=30

# Set to "true" only when the app is served over HTTPS (adds the Secure cookie
# flag). Keep "false" for plain http://localhost development.
COOKIE_SECURE="false"

# Optional cookie domain. Leave empty for localhost.
COOKIE_DOMAIN=""

# -----------------------------------------------------------------------------
# Chat rules
# -----------------------------------------------------------------------------
# Max accepted chat message length in characters (hard ceiling: 4000).
MESSAGE_MAX_LENGTH=2000

# How long a peer may stay disconnected (tab closed, network loss, restart)
# before the chat is abandoned. Disconnecting is not leaving.
PEER_RECONNECT_GRACE_MS=15000

# -----------------------------------------------------------------------------
# Search filters and matching
# -----------------------------------------------------------------------------
# A filtered search is matched strictly: an undeclared value never satisfies a
# filter, and both sides have to accept each other. Widening a search is
# opt-in per user, visible while it happens, and driven by these two values.
#
# How long a filtered search waits before the FIRST filter is dropped.
# 0 disables widening completely (used by the integration tests).
MATCH_RELAX_AFTER_MS=45000
# How much longer each further filter waits before it is dropped too.
MATCH_RELAX_STEP_MS=20000

# Housekeeping interval: stale queue tickets, abandoned chats, expired
# requests, retention cleanup, and filter widening. 0 turns it off.
MAINTENANCE_INTERVAL_MS=15000

# -----------------------------------------------------------------------------
# Web app
# -----------------------------------------------------------------------------
# Base URL of the API as seen from the browser. Must be reachable from the
# browser, not from inside a container.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# Abuse protection (rate limits)
# -----------------------------------------------------------------------------
RATE_LIMIT_HTTP_PER_MINUTE=120
RATE_LIMIT_SESSION_CREATE_PER_HOUR=30
RATE_LIMIT_CHAT_MESSAGES_PER_10S=20
RATE_LIMIT_LOOKUP_PER_MINUTE=20
RATE_LIMIT_CONNECT_REQUEST_PER_MINUTE=10
# How many "contact the owner" messages one identity may send per day. Small on
# purpose: the form is for a few considered messages, and the owner's inbox is a
# spam target. Keyed by identity, not by IP address.
RATE_LIMIT_OWNER_MESSAGE_PER_DAY=5

# Maximum simultaneous WebSocket connections per anonymous identity.
MAX_SOCKETS_PER_USER=4

# Maximum pending outgoing requests to a User ID one identity may have at once.
MAX_PENDING_REQUESTS_PER_USER=3

# -----------------------------------------------------------------------------
# Data retention
# -----------------------------------------------------------------------------
# Days to keep abuse reports (including the reported message snapshot).
REPORT_RETENTION_DAYS=30
# Retention for expired/revoked identity sessions.
SESSION_RETENTION_DAYS=7
# Retention for security/abuse events (blocks, report decisions, bans).
SECURITY_EVENT_RETENTION_DAYS=90
# Days to keep messages users sent through "Связаться с администрацией". Longer than a
# report because it is correspondence rather than an incident, but still bounded:
# the message text is deleted automatically when this passes.
OWNER_MESSAGE_RETENTION_DAYS=180

# -----------------------------------------------------------------------------
# Owner archive (optional, off by default)
# -----------------------------------------------------------------------------
# The archive of conversations is a separate, deliberate feature. It is OFF until
# the owner sets the key below AND switches it on at http://localhost:3000/admin.
# With no key, that page and every admin API route do not exist at all.
#
# The key is a password: at least 32 characters, never committed, never shared.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Then uncomment the line and paste the generated value between the quotes.
# Leave it commented out to keep the whole owner surface disabled.
# See docs/SECURITY.md §13 and docs/DECISIONS.md D21.
# ADMIN_TOKEN="<paste the generated value>"

# -----------------------------------------------------------------------------
# Abuse investigation (optional, off by default)
# -----------------------------------------------------------------------------
# When set, the API stores a salted hash of the client IP and User-Agent next to
# security events, so an operator can correlate abuse without storing raw
# addresses. Unset — the default — means AnonLink stores no client-identifying
# data at all. (Transcripts are a separate setting: the owner archive above,
# which is off unless the owner turns it on.)
# Must be at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ABUSE_HASH_SALT=""
