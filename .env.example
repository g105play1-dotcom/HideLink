# =============================================================================
# AnonLink — environment configuration
# =============================================================================
# Copy this file to `.env` in the repository root and adjust the values.
#
#   PowerShell:  Copy-Item .env.example .env
#
# `.env` is git-ignored. NEVER commit real secrets to the repository.
# Both the API (apps/api) and the web app (apps/web) read this single file.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local PostgreSQL installed by `pnpm setup` listens on port 5432.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://anonlink:anonlink@localhost:5432/anonlink?schema=public"

# Only needed by `prisma migrate dev` when it has to create a shadow database.
# Leave commented out to let Prisma create a temporary one automatically.
# SHADOW_DATABASE_URL=""

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
NODE_ENV="development"
API_PORT=3001
# Loopback only, so the API is not exposed to the local network and Windows does
# not need a firewall exception. Set to "0.0.0.0" only if you deliberately want
# other devices (or a container) to reach the API.
API_HOST="127.0.0.1"

# Comma-separated list of browser origins allowed to call the API and to open
# a WebSocket connection. Must match exactly (scheme + host + port).
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# -----------------------------------------------------------------------------
# Anonymous sessions
# -----------------------------------------------------------------------------
# Lifetime of an anonymous identity session, in days.
SESSION_TTL_DAYS=30

# Set to "true" only when the app is served over HTTPS (adds the Secure cookie
# flag). Keep "false" for plain http://localhost development.
COOKIE_SECURE="false"

# Optional cookie domain. Leave empty for localhost.
COOKIE_DOMAIN=""

# Max accepted chat message length in characters.
MESSAGE_MAX_LENGTH=2000

# -----------------------------------------------------------------------------
# Web app
# -----------------------------------------------------------------------------
# Base URL of the API as seen from the browser. Must be reachable from the
# browser, not from inside a container.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# Abuse protection (rate limits)
# -----------------------------------------------------------------------------
RATE_LIMIT_HTTP_PER_MINUTE=120
RATE_LIMIT_SESSION_CREATE_PER_HOUR=30
RATE_LIMIT_CHAT_MESSAGES_PER_10S=20
RATE_LIMIT_LOOKUP_PER_MINUTE=20
RATE_LIMIT_CONNECT_REQUEST_PER_MINUTE=10

# Maximum simultaneous WebSocket connections per anonymous identity.
MAX_SOCKETS_PER_USER=4

# -----------------------------------------------------------------------------
# Data retention
# -----------------------------------------------------------------------------
# Days to keep abuse reports (including the reported message snapshot).
REPORT_RETENTION_DAYS=30
# Retention for expired/revoked identity sessions.
SESSION_RETENTION_DAYS=7
